# ---------- Knack (server only; never expose) ----------
KNACK_APP_ID=6ac2990a22b9402692269ca2
KNACK_API_KEY=            # private REST API key from Knack > Settings > API & Code
KNACK_APP_TZ=America/New_York   # change to America/Los_Angeles after you switch the Knack app time zone

# ---------- Frontend (safe to expose) ----------
VITE_KNACK_APP_ID=6ac2990a22b9402692269ca2
VITE_KNACK_CLIENT_ID=6ac2af887b689108d9f73b8c
VITE_KNACK_API_BASE=https://api.knack.com/v1

# ---------- App ----------
APP_BASE_URL=https://app.asifmalikmd.com
STATE_SECRET=             # long random string; signs ID.me state
CRON_SECRET=              # long random string; Vercel sends it to the daily reminder job
CONSULT_FEE=495
IME_FEE=1300
REVIEW_BASE_FEE=500
REVIEW_INCLUDED_PAGES=500
REVIEW_PER_PAGE=0.75

# ---------- ID.me (blank = test mode) ----------
IDME_CLIENT_ID=
IDME_CLIENT_SECRET=
IDME_BASE=https://api.idmelabs.com    # sandbox; production is https://api.id.me
IDME_SCOPE=identity

# ---------- Sphere / TrustCommerce (blank = test mode) ----------
SPHERE_CUSTOMER_ID=
SPHERE_PASSWORD=
SPHERE_HOSTED_PAGE_URL=

# ---------- Daily video (blank = test mode) ----------
DAILY_API_KEY=
DAILY_DOMAIN=             # e.g. asifmalikmd.daily.co

# ---------- Email (blank = no email, in-portal only) ----------
RESEND_API_KEY=
EMAIL_FROM=Asif Malik MD <updates@asifmalikmd.com>

# ---------- Phone assistant (pilot; off unless VOICE_ATTENDANT_ON=true) ----------
VOICE_ATTENDANT_ON=false
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=        # required: calls are ignored without signature checks
VOICE_ALLOWED_NUMBERS=    # firms that may call, comma-separated; must also be a linked organization user's phone
VOICE_ALERT_EMAIL=        # where "new phone message" alerts go (no details in the email)
VOICE_TRANSFER_NUMBER=    # optional: "talk to a person" and emergencies are transferred here
VOICE_ANNOUNCEMENT=       # optional: played after the greeting, e.g. "We're closed today due to inclement weather."
VOICE_ANNOUNCEMENT_ES=    # optional: the Spanish version
VOICE_ANNOUNCEMENT_UNTIL= # optional: last day to play it, YYYY-MM-DD
VOICE_OFFICE_HOURS=1-5 8-17  # weekdays and hours (Pacific) the office is open; crisis guidance after hours says 911 / ER
VOICE_AUTOMATION_SCHEDULE=request    # request (offers real open times; you confirm) | off (takes a message)
VOICE_AUTOMATION_RESCHEDULE=request
VOICE_AUTOMATION_REFILL=request
VOICE_ATTENDANT_TTS_VOICE_ES=        # optional Spanish voice (default Polly.Lupe-Neural; falls back to the basic voice)
VOICE_HOURS=              # what anyone may hear, no verification (blank = offer a message)
VOICE_ADDRESS=
VOICE_FAX=
VOICE_NEW_PATIENTS=
VOICE_ATTENDANT_TTS_VOICE=female
AZURE_OPENAI_ENDPOINT=    # optional: AI understanding; keyword matching without it
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
